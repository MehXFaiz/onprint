{
  "name": "onprint",
  "version": "1.0.0",
  "private": true,
  "description": "ONPRINT — Express & React printing-services platform",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "postinstall": "npm ci --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently -n CLIENT,SERVER -c blue,green \"npm:dev:client\" \"npm:dev\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
