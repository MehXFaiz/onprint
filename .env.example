# Root overview of every environment variable ONPRINT uses.
# The actual working files each app reads are:
#   server/.env  (copy from server/.env.example)
#   client/.env  (copy from client/.env.example — Vite only reads vars prefixed VITE_)
# Never commit real values. This file only documents placeholders.

PORT=5000
MONGODB_URI=
JWT_SECRET=
NODE_ENV=production
CLIENT_URL=
API_URL=
