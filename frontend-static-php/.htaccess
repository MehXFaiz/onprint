# ==============================================================================
# ONPRINT Dubai — Static PHP Frontend (.htaccess for Hostinger / Apache)
# Compatible with public_html root or subdirectory deployment
# ==============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Modern Media & Web MIME Types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Clean URL Front-Controller Routing to index.php
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct external access to internal PHP includes & raw JSON data store
  RewriteRule ^(includes|pages|data)(/|$) - [F,L]

  # Serve existing static files (images, CSS, JS, robots.txt, sitemap.xml, etc.) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all clean frontend URLs through index.php
  RewriteRule ^ index.php [QSA,L]
</IfModule>
