<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 900" width="1200" height="900" role="img" aria-label="Professional Magnetic Metal Name Badges">
  <defs>
    <!-- Seamless Light Studio Background -->
    <radialGradient id="badgeStudioBg" cx="50%" cy="45%" r="70%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="60%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </radialGradient>

    <!-- Brushed Champagne Gold Metal Finish -->
    <linearGradient id="champagneGold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#dfba73"/>
      <stop offset="20%" stop-color="#fbf4d9"/>
      <stop offset="45%" stop-color="#cf9f4d"/>
      <stop offset="70%" stop-color="#faedd0"/>
      <stop offset="90%" stop-color="#b68837"/>
      <stop offset="100%" stop-color="#d6ad60"/>
    </linearGradient>

    <!-- Brushed Silver Aluminum Frame -->
    <linearGradient id="silverBevel" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#cbd5e1"/>
      <stop offset="100%" stop-color="#94a3b8"/>
    </linearGradient>

    <!-- Neodymium Magnet Casing Gradient (Dark Steel & Blue Magnet Backer) -->
    <linearGradient id="magnetCase" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>

    <radialGradient id="neoMagnet" cx="40%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="40%" stop-color="#94a3b8"/>
      <stop offset="80%" stop-color="#475569"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </radialGradient>

    <!-- Luxury Soft Drop Shadows -->
    <filter id="badgeShadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="25" stdDeviation="22" flood-color="#0f172a" flood-opacity="0.28"/>
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#000000" flood-opacity="0.15"/>
    </filter>

    <filter id="magnetShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="10" dy="20" stdDeviation="15" flood-color="#0f172a" flood-opacity="0.3"/>
    </filter>
  </defs>

  <!-- Studio Background -->
  <rect width="1200" height="900" fill="url(#badgeStudioBg)"/>

  <!-- Soft Pedestal Shadow -->
  <ellipse cx="600" cy="620" rx="460" ry="70" fill="#cbd5e1" fill-opacity="0.45"/>

  <!-- REAR COMPONENT: Magnetic 3-Disc Fastener Backing Plate (Shown Floating Behind / Beside) -->
  <g transform="translate(680, 200) rotate(14)" filter="url(#magnetShadow)">
    <!-- Backer Plate Plastic Body (Navy / Dark Grey) -->
    <rect width="360" height="130" rx="18" fill="url(#magnetCase)" stroke="#334155" stroke-width="2"/>
    <rect x="6" y="6" width="348" height="118" rx="14" fill="none" stroke="#475569" stroke-width="1"/>
    
    <!-- 3 Strong Neodymium Magnetic Nodes -->
    <!-- Node 1 -->
    <circle cx="65" cy="65" r="32" fill="url(#neoMagnet)" stroke="#0f172a" stroke-width="1.5"/>
    <circle cx="65" cy="65" r="22" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.6"/>
    <circle cx="65" cy="65" r="8" fill="#334155"/>

    <!-- Node 2 -->
    <circle cx="180" cy="65" r="32" fill="url(#neoMagnet)" stroke="#0f172a" stroke-width="1.5"/>
    <circle cx="180" cy="65" r="22" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.6"/>
    <circle cx="180" cy="65" r="8" fill="#334155"/>

    <!-- Node 3 -->
    <circle cx="295" cy="65" r="32" fill="url(#neoMagnet)" stroke="#0f172a" stroke-width="1.5"/>
    <circle cx="295" cy="65" r="22" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.6"/>
    <circle cx="295" cy="65" r="8" fill="#334155"/>

    <!-- Backplate Caution Text -->
    <text x="180" y="118" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="10" font-weight="800" text-anchor="middle" letter-spacing="1.5">3X STRONG NEODYMIUM FASTENER • CLOTHING SAFE</text>
  </g>

  <!-- FOREGROUND MAIN BADGE: Brushed Champagne Gold Magnetic Badge -->
  <g transform="translate(180, 290)" filter="url(#badgeShadow)">
    
    <!-- Outer Metal Base with Rounded Corners (700 x 280) -->
    <rect width="700" height="280" rx="24" fill="url(#silverBevel)" stroke="#94a3b8" stroke-width="1.5"/>

    <!-- Brushed Champagne Gold Metal Inset Face (684 x 264) -->
    <rect x="8" y="8" width="684" height="264" rx="18" fill="url(#champagneGold)"/>

    <!-- Fine Brushed Metal Horizontal Grain Lines -->
    <line x1="12" y1="45" x2="688" y2="45" stroke="#ffffff" stroke-width="0.8" stroke-opacity="0.4"/>
    <line x1="12" y1="90" x2="688" y2="90" stroke="#78350f" stroke-width="0.4" stroke-opacity="0.2"/>
    <line x1="12" y1="135" x2="688" y2="135" stroke="#ffffff" stroke-width="0.8" stroke-opacity="0.35"/>
    <line x1="12" y1="180" x2="688" y2="180" stroke="#78350f" stroke-width="0.4" stroke-opacity="0.2"/>
    <line x1="12" y1="225" x2="688" y2="225" stroke="#ffffff" stroke-width="0.8" stroke-opacity="0.4"/>

    <!-- Elegant Inset Border Chamfer -->
    <rect x="22" y="22" width="656" height="236" rx="12" fill="none" stroke="#78350f" stroke-width="1.2" stroke-opacity="0.4"/>
    <rect x="24" y="24" width="652" height="232" rx="11" fill="none" stroke="#ffffff" stroke-width="0.8" stroke-opacity="0.7"/>

    <!-- Left Logo Emblem Box -->
    <g transform="translate(55, 60)">
      <rect width="95" height="95" rx="18" fill="#A82F19" stroke="#ffffff" stroke-width="2"/>
      <polygon points="47.5,20 75,47.5 47.5,75 20,47.5" fill="none" stroke="#ffffff" stroke-width="3"/>
      <circle cx="47.5" cy="47.5" r="10" fill="#fef08a"/>
      <text x="47.5" y="88" fill="#ffffff" font-family="system-ui, sans-serif" font-size="9" font-weight="900" text-anchor="middle" letter-spacing="1">ONPRINT</text>
    </g>

    <!-- Professional Employee Identity Block -->
    <g transform="translate(180, 75)">
      <!-- Name -->
      <text x="0" y="36" fill="#0f172a" font-family="'Cinzel', 'Playfair Display', Georgia, serif" font-size="34" font-weight="bold" letter-spacing="2">ALEXANDER WRIGHT</text>
      
      <!-- Accent Line -->
      <line x1="0" y1="58" x2="460" y2="58" stroke="#A82F19" stroke-width="2.5"/>

      <!-- Title & Dept -->
      <text x="0" y="88" fill="#A82F19" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="800" letter-spacing="3">SENIOR CLIENT DIRECTOR</text>
      <text x="0" y="115" fill="#475569" font-family="system-ui, -apple-system, sans-serif" font-size="12.5" font-weight="700" letter-spacing="2">PRIVATE WEALTH & COMMERCIAL PRINTING</text>
    </g>

    <!-- Magnetic Fastener Icon Badge in Bottom Left -->
    <g transform="translate(55, 195)">
      <rect width="180" height="32" rx="8" fill="#0f172a" fill-opacity="0.85"/>
      <circle cx="20" cy="16" r="6" fill="#f59e0b"/>
      <text x="35" y="21" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="10" font-weight="800" letter-spacing="1.5">MAGNETIC FASTENER</text>
    </g>

    <!-- High-End Spec Tag in Bottom Right -->
    <text x="650" y="218" fill="#78350f" font-family="system-ui, sans-serif" font-size="11" font-weight="800" text-anchor="end" letter-spacing="2">ANODIZED BRUSHED GOLD</text>

    <!-- Specular Light Sweep / Glare -->
    <path d="M 160 8 L 290 8 L 210 272 L 80 272 Z" fill="#ffffff" fill-opacity="0.25"/>
    <path d="M 330 8 L 370 8 L 290 272 L 250 272 Z" fill="#ffffff" fill-opacity="0.15"/>
  </g>

  <!-- Specification Callout -->
  <g transform="translate(860, 790)">
    <rect width="280" height="65" rx="12" fill="#ffffff" fill-opacity="0.95" stroke="#e2e8f0" stroke-width="1.5"/>
    <text x="20" y="28" fill="#0f172a" font-family="system-ui, sans-serif" font-size="14" font-weight="800">Brushed Champagne Metal</text>
    <text x="20" y="48" fill="#64748b" font-family="system-ui, sans-serif" font-size="12" font-weight="600">3-Disc Neodymium Magnetic Backer</text>
  </g>
</svg>
