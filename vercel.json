{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server.js",
      "bindings": [
        {
          "type": "service",
          "service": "client",
          "format": "url",
          "env": "CLIENT_SERVICE_URL"
        }
      ]
    },
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "streamlit-cloud": {
      "root": "streamlit-cloud",
      "runtime": "python"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api|assets|uploads).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|ads\\.txt)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(health|healthz|ping)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
