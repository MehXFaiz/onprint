PORT=5000
NODE_ENV=development

# JWT (used starting Phase 4 — Auth)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Public API URL the frontend should call in production
API_URL=http://localhost:5000/api

# File storage driver: local | cloudinary | s3 (used starting Phase 7 — Quotes/uploads)
STORAGE_DRIVER=local
