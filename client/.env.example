# Vite only exposes variables prefixed with VITE_ to client code.
# Copy this file to .env for local development and .env.production for production builds.

VITE_API_URL=http://localhost:5000/api

# Business WhatsApp Configuration (Used for all WhatsApp quote & inquiry CTAs)
# Format with country code (e.g. 447344546056 or 971501234567 for UAE)
VITE_WHATSAPP_NUMBER=447344546056

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-GM4H4QNS0D
