PORT=5000
NODE_ENV=development

# GoDaddy MySQL Database Configuration
DB_HOST=YOUR_GODADDY_MYSQL_HOST
DB_PORT=3306
DB_NAME=onprintdb
DB_USER=YOUR_GODADDY_DATABASE_USER
DB_PASSWORD=YOUR_GODADDY_DATABASE_PASSWORD

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS and API URLs
CLIENT_URL=http://localhost:5173,https://0nprint.com,https://www.0nprint.com
API_URL=http://localhost:5000/api
STORAGE_DRIVER=local
