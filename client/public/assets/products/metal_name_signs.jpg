<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 900" width="1200" height="900" role="img" aria-label="Metal Name Signs and Architectural Wall Plaques">
  <defs>
    <!-- Architectural Wall Background Gradient -->
    <radialGradient id="wallBg" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#f1f5f9"/>
      <stop offset="60%" stop-color="#e2e8f0"/>
      <stop offset="100%" stop-color="#cbd5e1"/>
    </radialGradient>

    <!-- Brushed Brass & Champagne Gold Plate Gradient -->
    <linearGradient id="brushedBrass" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#d4af37"/>
      <stop offset="15%" stop-color="#f3e5ab"/>
      <stop offset="35%" stop-color="#c5a059"/>
      <stop offset="55%" stop-color="#fdf6c7"/>
      <stop offset="75%" stop-color="#b8860b"/>
      <stop offset="90%" stop-color="#e6ca65"/>
      <stop offset="100%" stop-color="#c5a059"/>
    </linearGradient>

    <!-- Brushed Silver Aluminum Under-Plate -->
    <linearGradient id="brushedSilver" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#94a3b8"/>
      <stop offset="25%" stop-color="#f8fafc"/>
      <stop offset="50%" stop-color="#cbd5e1"/>
      <stop offset="75%" stop-color="#e2e8f0"/>
      <stop offset="100%" stop-color="#64748b"/>
    </linearGradient>

    <!-- Standoff Chrome Hardware Gradient -->
    <radialGradient id="standoffChrome" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="40%" stop-color="#cbd5e1"/>
      <stop offset="75%" stop-color="#475569"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </radialGradient>

    <!-- Realistic Drop Shadow for Standoff Floating Plaque -->
    <filter id="wallPlaqueShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="15" dy="30" stdDeviation="30" flood-color="#0f172a" flood-opacity="0.38"/>
      <feDropShadow dx="5" dy="10" stdDeviation="12" flood-color="#334155" flood-opacity="0.22"/>
    </filter>

    <filter id="engraveDeep" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="1" dy="1" stdDeviation="1" flood-color="#ffffff" flood-opacity="0.8"/>
      <feDropShadow dx="-1" dy="-1" stdDeviation="1" flood-color="#000000" flood-opacity="0.9"/>
    </filter>
  </defs>

  <!-- Wall Background -->
  <rect width="1200" height="900" fill="url(#wallBg)"/>

  <!-- Subtle Architectural Wall Grid / Panel Seams -->
  <line x1="0" y1="200" x2="1200" y2="200" stroke="#cbd5e1" stroke-width="1.5" stroke-opacity="0.6"/>
  <line x1="0" y1="700" x2="1200" y2="700" stroke="#cbd5e1" stroke-width="1.5" stroke-opacity="0.6"/>
  <line x1="600" y1="0" x2="600" y2="900" stroke="#cbd5e1" stroke-width="1.5" stroke-opacity="0.6"/>

  <!-- Floating Dual-Layer Metal Sign Group -->
  <g transform="translate(175, 175)" filter="url(#wallPlaqueShadow)">
    
    <!-- Base Layer: Matte Black / Anodized Dark Trim (850 x 550) -->
    <rect width="850" height="550" rx="16" fill="#0f172a" stroke="#334155" stroke-width="2"/>

    <!-- Mid Layer: Brushed Anodized Brass Metal Plate (810 x 510) -->
    <rect x="20" y="20" width="810" height="510" rx="10" fill="url(#brushedBrass)"/>
    
    <!-- Fine Brushed Horizontal Texture Lines -->
    <line x1="20" y1="80" x2="830" y2="80" stroke="#ffffff" stroke-width="0.75" stroke-opacity="0.35"/>
    <line x1="20" y1="160" x2="830" y2="160" stroke="#78350f" stroke-width="0.5" stroke-opacity="0.2"/>
    <line x1="20" y1="240" x2="830" y2="240" stroke="#ffffff" stroke-width="0.75" stroke-opacity="0.3"/>
    <line x1="20" y1="320" x2="830" y2="320" stroke="#78350f" stroke-width="0.5" stroke-opacity="0.2"/>
    <line x1="20" y1="400" x2="830" y2="400" stroke="#ffffff" stroke-width="0.75" stroke-opacity="0.35"/>

    <!-- Chamfered Inset Border Line -->
    <rect x="38" y="38" width="774" height="474" rx="6" fill="none" stroke="#78350f" stroke-width="1.5" stroke-opacity="0.6"/>
    <rect x="42" y="42" width="766" height="466" rx="5" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.7"/>

    <!-- 4 Corner Stainless Steel Standoff Mounts (Floating Bolt Heads) -->
    <!-- Top-Left -->
    <g transform="translate(60, 60)">
      <circle cx="0" cy="0" r="18" fill="url(#standoffChrome)" stroke="#0f172a" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.8"/>
      <circle cx="0" cy="0" r="4" fill="#1e293b"/>
    </g>
    <!-- Top-Right -->
    <g transform="translate(790, 60)">
      <circle cx="0" cy="0" r="18" fill="url(#standoffChrome)" stroke="#0f172a" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.8"/>
      <circle cx="0" cy="0" r="4" fill="#1e293b"/>
    </g>
    <!-- Bottom-Left -->
    <g transform="translate(60, 490)">
      <circle cx="0" cy="0" r="18" fill="url(#standoffChrome)" stroke="#0f172a" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.8"/>
      <circle cx="0" cy="0" r="4" fill="#1e293b"/>
    </g>
    <!-- Bottom-Right -->
    <g transform="translate(790, 490)">
      <circle cx="0" cy="0" r="18" fill="url(#standoffChrome)" stroke="#0f172a" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.8"/>
      <circle cx="0" cy="0" r="4" fill="#1e293b"/>
    </g>

    <!-- ONPRINT Architectural Header Icon -->
    <g transform="translate(425, 140)">
      <circle cx="0" cy="0" r="32" fill="#A82F19" stroke="#78350f" stroke-width="2"/>
      <polygon points="0,-18 16,0 0,18 -16,0" fill="#ffffff"/>
      <circle cx="0" cy="0" r="5" fill="#A82F19"/>
    </g>

    <!-- Deep Precision Engraved Typography (Dark Enamel Infill) -->
    <text x="425" y="235" fill="#0f172a" font-family="'Cinzel', 'Playfair Display', Georgia, serif" font-size="38" font-weight="bold" text-anchor="middle" letter-spacing="6">EXECUTIVE BOARDROOM</text>
    
    <line x1="200" y1="270" x2="650" y2="270" stroke="#A82F19" stroke-width="3"/>
    
    <text x="425" y="325" fill="#A82F19" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="900" text-anchor="middle" letter-spacing="8">SUITE 1400 • LEVEL 14</text>

    <text x="425" y="375" fill="#334155" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="700" text-anchor="middle" letter-spacing="5">ONPRINT REGIONAL HEADQUARTERS</text>
    <text x="425" y="405" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" text-anchor="middle" letter-spacing="4">DUBAI INTERNATIONAL FINANCIAL CENTRE</text>

    <!-- Metallic Highlight Glint across Sign -->
    <path d="M 220 20 L 360 20 L 280 530 L 140 530 Z" fill="#ffffff" fill-opacity="0.22"/>
  </g>

  <!-- Spec Tag -->
  <g transform="translate(870, 800)">
    <rect width="270" height="65" rx="12" fill="#ffffff" fill-opacity="0.95" stroke="#e2e8f0" stroke-width="1.5"/>
    <text x="20" y="28" fill="#0f172a" font-family="system-ui, sans-serif" font-size="14" font-weight="800">Brushed Brass & Aluminum</text>
    <text x="20" y="48" fill="#64748b" font-family="system-ui, sans-serif" font-size="12" font-weight="600">Architectural Standoff Fixings</text>
  </g>
</svg>
